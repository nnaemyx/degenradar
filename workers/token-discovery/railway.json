{
  "$schema": "https://schema.railway.app/railway.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "../../Dockerfile",
    "dockerBuildTarget": "worker-token-discovery"
  },
  "deploy": {
    "startCommand": "pnpm --filter @degenradar/worker-token-discovery start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
