# ========================
# DegenRadar Environment
# ========================
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────
DATABASE_URL=postgresql://degenradar:degenradar@localhost:5432/degenradar

# ─── Redis ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Helius ──────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ─── Birdeye ─────────────────────────────────────
BIRDEYE_API_KEY=your_birdeye_api_key_here

# ─── Jupiter ─────────────────────────────────────
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ─── Telegram ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── API ─────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_SECRET=change_me_to_a_random_secret

# ─── Web ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── Scoring ─────────────────────────────────────
MIN_LIQUIDITY_USD=5000
MIN_MARKET_CAP_USD=10000
MAX_MARKET_CAP_USD=10000000
OPPORTUNITY_ALERT_THRESHOLD=75
RISK_BLOCK_THRESHOLD=80

# ─── Worker Concurrency ──────────────────────────
TOKEN_WORKER_CONCURRENCY=20
TRADE_WORKER_CONCURRENCY=30
HOLDER_WORKER_CONCURRENCY=10
RISK_WORKER_CONCURRENCY=15
FEATURE_WORKER_CONCURRENCY=15
SCORING_WORKER_CONCURRENCY=20

# ─── Environment ─────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
