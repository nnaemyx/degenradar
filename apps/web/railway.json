{
  "$schema": "https://schema.railway.app/railway.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "../../Dockerfile",
    "dockerBuildTarget": "web"
  },
  "deploy": {
    "startCommand": "pnpm --filter @degenradar/web start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
