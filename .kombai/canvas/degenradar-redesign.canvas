      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@0.552.0/font/lucide.css\");\n.dr-app { --bg: #0c0f13; --surface: #11161c; --surface-2: #151b22; --line: #29313a; --line-soft: #202831; --ink: #edf1f4; --muted: #929ca7; --quiet: #68737f; --lime: #b7e77b; --purple: #b5a2f2; --amber: #efbd78; --red: #ef8980; background: var(--bg); color: var(--ink); font-family: 'Space Grotesk', sans-serif; }\n.dr-mono { font-family: 'DM Mono', monospace; }\n.dr-app .radar-row { transition: background-color .16s ease, border-color .16s ease; }\n.dr-app .radar-row:hover { background: rgba(255,255,255,.035); }\n.dr-app .radar-row.selected { background: linear-gradient(90deg, rgba(183,231,123,.09), rgba(183,231,123,.015) 62%, transparent); }\n.dr-app .radar-row.selected .row-rail { background: var(--lime); }\n.dr-app .row-rail { background: transparent; }\n.dr-app .focus-ring:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }\n.dr-app .risk-wash { background: linear-gradient(115deg, rgba(239,189,120,.09), rgba(239,189,120,.025) 72%, rgba(17,22,28,.2)); }\n.dr-app .market-cell + .market-cell { border-left: 1px solid var(--line-soft); }\n.dr-app .scan-mark { color: var(--lime); }\n@media (max-width: 1023px) {\n  .dr-app.mobile-inspecting .radar-column { display: none; }\n  .dr-app.mobile-inspecting .inspection-column { display: block; }\n  .dr-app.mobile-inspecting .mobile-back { display: inline-flex; }\n  .dr-app .mobile-back { display: none; }\n}\n</style>\n<div class=\"dr-app min-h-screen px-4 pb-12 pt-5 sm:px-7 lg:px-10 lg:pt-7\" data-kid=\"1\" data-name=\"workspace application container\" id=\"workspace\">\n    <div class=\"mx-auto max-w-[1440px]\" data-kid=\"1-1\" data-name=\"workspace layout wrapper\">\n        <header class=\"flex flex-wrap items-center justify-between gap-4 border-b border-[var(--line)] pb-5 lg:pb-6\" data-kid=\"1-1-1\" data-name=\"workspace header\">\n            <div class=\"flex items-center gap-3.5\" data-kid=\"1-1-1-1\" data-name=\"brand and logo area\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-[13px] border border-[#39434a] bg-[#131a1d]\" data-kid=\"1-1-1-1-1\" data-name=\"logo container\">\n                    <svg aria-label=\"DegenRadar DR scan-aperture logo\" class=\"h-9 w-9\" data-kid=\"1-1-1-1-1-1\" data-name=\"DR scan-aperture logo\" fill=\"none\" role=\"img\" viewbox=\"0 0 44 44\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M8 14V9h5M31 9h5v5M36 30v5h-5M13 35H8v-5\" stroke=\"#82917e\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\">\n                        </path>\n                        <path d=\"M12.5 15h5a7 7 0 0 1 0 14h-5V15Z\" stroke=\"#E9EFE7\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                        <path d=\"M25 15h4.4c3 0 4.7 1.5 4.7 4s-1.7 4-4.7 4H25v6m6.1-6 4 6\" stroke=\"#B5A2F2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                        <path d=\"M7.5 22h10.7m8 0H37\" stroke=\"#B7E77B\" stroke-linecap=\"round\" stroke-width=\"1.6\">\n                        </path>\n                        <circle cx=\"22.3\" cy=\"22\" fill=\"#B7E77B\" r=\"2.3\" stroke=\"#0C0F13\" stroke-width=\"1\">\n                        </circle>\n                    </svg>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"app identity container\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-2-1\" data-name=\"app title and chain label\">\n                        <span class=\"text-[17px] font-bold tracking-[.13em] text-[#f2f4f3]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"application name text\">\n                            DEGENRADAR\n                        </span>\n                        <span class=\"hidden rounded border border-[#384148] px-1.5 py-[3px] text-[9px] font-medium tracking-[.12em] text-[#9eaaa7] sm:inline\" data-kid=\"1-1-1-1-2-1-2\" data-name=\"blockchain label\">\n                            SOLANA\n                        </span>\n                    </div>\n                    <p class=\"mt-0.5 text-[11px] tracking-[.025em] text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"application subtitle\">\n                        Token intelligence · inspection workspace\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-3 sm:gap-5\" data-kid=\"1-1-1-2\" data-name=\"workspace status and metrics\">\n                <div class=\"flex items-center gap-2 rounded-full border border-[#464139] bg-[#191a18] px-3 py-1.5\" data-kid=\"1-1-1-2-1\" data-name=\"status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--amber)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status indicator dot\">\n                    </span>\n                    <span class=\"dr-mono text-[10px] tracking-[.05em] text-[#dfc294]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status label text\">\n                        SAMPLE DATA · NOT LIVE\n                    </span>\n                </div>\n                <div class=\"hidden items-center gap-4 border-l border-[var(--line)] pl-5 sm:flex\" data-kid=\"1-1-1-2-2\" data-name=\"metrics overview container\">\n                    <div data-kid=\"1-1-1-2-2-1\" data-name=\"monitored tokens metric\">\n                        <p class=\"dr-mono text-[9px] tracking-[.12em] text-[var(--quiet)]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"monitored label\">\n                            MONITORED\n                        </p>\n                        <p class=\"dr-mono mt-1 text-[12px] text-[var(--ink)]\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"monitored count\">\n                            86\n                            <span class=\"text-[var(--quiet)]\" data-kid=\"1-1-1-2-2-1-2-1\" data-name=\"monitored count label\">\n                                tokens\n                            </span>\n                        </p>\n                    </div>\n                    <div data-kid=\"1-1-1-2-2-2\" data-name=\"alerts metric\">\n                        <p class=\"dr-mono text-[9px] tracking-[.12em] text-[var(--quiet)]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"alerts label\">\n                            ALERTS\n                        </p>\n                        <p class=\"dr-mono mt-1 text-[12px] text-[var(--ink)]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"alerts count\">\n                            04\n                            <span class=\"text-[var(--quiet)]\" data-kid=\"1-1-1-2-2-2-2-1\" data-name=\"alerts count label\">\n                                sample\n                            </span>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <main class=\"pt-8 lg:pt-10\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <section class=\"mb-6 flex flex-col justify-between gap-4 sm:mb-7 sm:flex-row sm:items-end\" data-kid=\"1-1-2-1\" data-name=\"page intro section\">\n                <div class=\"max-w-[700px]\" data-kid=\"1-1-2-1-1\" data-name=\"intro headline group\">\n                    <p class=\"dr-mono text-[10px] font-medium uppercase tracking-[.18em] text-[#a8b894]\" data-kid=\"1-1-2-1-1-1\" data-name=\"pre-headline notice text\">\n                        REVIEW BEFORE YOU OPEN AN EXTERNAL TOOL\n                    </p>\n                    <h1 class=\"mt-2 text-[27px] font-semibold leading-tight tracking-[-.035em] sm:text-[32px]\" data-kid=\"1-1-2-1-1-2\" data-name=\"main section title\">\n                        Token inspection\n                    </h1>\n                    <p class=\"mt-2 max-w-[620px] text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-1-2-1-1-3\" data-name=\"section description text\">\n                        Compare radar results, review independent scores and available market context, then choose where to continue.\n                    </p>\n                </div>\n                <div class=\"dr-mono flex items-center gap-2 pb-1 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-2-1-2\" data-name=\"snapshot state indicator\">\n                    <span class=\"inline-block h-1.5 w-1.5 rounded-full bg-[#78847e]\" data-kid=\"1-1-2-1-2-1\" data-name=\"snapshot indicator dot\">\n                    </span>\n                    Snapshot state · sample fixture\n                </div>\n            </section>\n            <section aria-label=\"Token search\" class=\"mb-6 rounded-[14px] border border-[var(--line)] bg-[var(--surface)] p-3.5 sm:p-4\" data-kid=\"1-1-2-2\" data-name=\"token search section\">\n                <label class=\"mb-2 block text-[11px] font-semibold text-[#dce3e5]\" data-kid=\"1-1-2-2-1\" data-name=\"search input label\" for=\"token-search\">\n                    Search tokens or inspect a mint\n                </label>\n                <div class=\"flex flex-col gap-2 sm:flex-row\" data-kid=\"1-1-2-2-2\" data-name=\"search interactive group\">\n                    <div class=\"relative min-w-0 flex-1\" data-kid=\"1-1-2-2-2-1\" data-name=\"search input wrapper\">\n                        <i aria-hidden=\"true\" class=\"icon icon-search pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-[var(--muted)]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"search icon\">\n                        </i>\n                        <input autocomplete=\"off\" class=\"focus-ring h-11 w-full rounded-[9px] border border-[#343d47] bg-[#0c1015] pl-10 pr-4 text-[13px] text-[#eef2f4] placeholder:text-[#737e88]\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"token search input\" id=\"token-search\" placeholder=\"Token name, symbol, or paste a Solana mint address…\" type=\"search\"/>\n                    </div>\n                    <button class=\"focus-ring flex h-11 shrink-0 items-center justify-center gap-2 rounded-[9px] border border-[#536449] bg-[#202920] px-4 text-[12px] font-semibold text-[#d0e8b2] hover:bg-[#293528]\" data-kid=\"1-1-2-2-2-2\" data-name=\"scan action button\" id=\"scan-mint\">\n                        <i aria-hidden=\"true\" class=\"icon icon-scan-line text-[14px]\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"scan icon\">\n                        </i>\n                        <span data-kid=\"1-1-2-2-2-2-2\" data-name=\"scan button label\">\n                            Scan this mint\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mt-2.5 flex flex-wrap items-center justify-between gap-2\" data-kid=\"1-1-2-2-3\" data-name=\"search helper area\">\n                    <p class=\"text-[11px] leading-5 text-[var(--quiet)]\" data-kid=\"1-1-2-2-3-1\" data-name=\"search instruction text\">\n                        Names filter the radar. A full address starts a separate on-demand scan.\n                    </p>\n                    <p aria-live=\"polite\" class=\"dr-mono text-[10px] text-[#d2c49e]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2\" data-name=\"scan feedback message\" data-reason=\"text updated when scan action is triggered\" id=\"scan-feedback\">\n                    </p>\n                </div>\n            </section>\n            <div class=\"grid grid-cols-1 items-start gap-5 lg:grid-cols-[356px_minmax(0,1fr)] lg:gap-6\" data-kid=\"1-1-2-3\" data-name=\"workspace columns container\">\n                <aside class=\"radar-column overflow-hidden rounded-[14px] border border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-1-2-3-1\" data-name=\"radar list sidebar\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[var(--line)] px-4 py-4\" data-kid=\"1-1-2-3-1-1\" data-name=\"radar header\">\n                        <div data-kid=\"1-1-2-3-1-1-1\" data-name=\"radar title group\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-1-1-1-1\" data-name=\"radar title with icon\">\n                                <span class=\"scan-mark inline-flex h-5 w-5 items-center justify-center\" data-kid=\"1-1-2-3-1-1-1-1-1\" data-name=\"radar icon container\">\n                                    <svg aria-hidden=\"true\" class=\"h-[18px] w-[18px]\" data-kid=\"1-1-2-3-1-1-1-1-1-1\" data-name=\"radar icon\" fill=\"none\" viewbox=\"0 0 20 20\">\n                                        <path d=\"M3 7V4h3m8 0h3v3m0 6v3h-3m-8 0H3v-3\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.4\">\n                                        </path>\n                                        <path d=\"M3 10h5m4 0h5\" stroke=\"currentColor\" stroke-width=\"1.4\">\n                                        </path>\n                                        <circle cx=\"10\" cy=\"10\" fill=\"currentColor\" r=\"1.8\">\n                                        </circle>\n                                    </svg>\n                                </span>\n                                <h2 class=\"text-[14px] font-semibold\" data-kid=\"1-1-2-3-1-1-1-1-2\" data-name=\"radar title\">\n                                    Token radar\n                                </h2>\n                            </div>\n                            <p class=\"dr-mono mt-1 pl-7 text-[10px] text-[var(--quiet)]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-1-1-2\" data-name=\"radar result count\" data-reason=\"text updated dynamically by filter script\">\n                                <span data-kid=\"1-1-2-3-1-1-1-2-1\" id=\"result-count\">\n                                    4\n                                </span>\n                                sample results\n                            </p>\n                        </div>\n                        <button aria-label=\"Sort results by opportunity score\" class=\"focus-ring flex items-center gap-1.5 rounded-md border border-[var(--line)] px-2.5 py-1.5 text-[10px] text-[#c4cbd0]\" data-kid=\"1-1-2-3-1-1-2\" data-name=\"sort button\" id=\"sort-button\">\n                            <span data-kid=\"1-1-2-3-1-1-2-1\" data-name=\"sort button label\">\n                                Opportunity\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon icon-chevron-down text-[11px] text-[var(--muted)]\" data-kid=\"1-1-2-3-1-1-2-2\" data-name=\"sort icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div aria-label=\"Filter token results\" class=\"flex flex-wrap gap-1.5 border-b border-[var(--line)] px-3 py-3\" data-kid=\"1-1-2-3-1-2\" data-name=\"radar filters container\">\n                        <button class=\"filter-chip focus-ring rounded-md border border-[#546044] bg-[#232c22] px-2.5 py-1.5 text-[10px] font-medium text-[#d9e9c7]\" data-dynamic=\"true\" data-filter=\"all\" data-kid=\"1-1-2-3-1-2-1\" data-name=\"all filter chip\" data-reason=\"class list and styles updated by filter script\">\n                            All\n                            <span class=\"dr-mono text-[#a9bd90]\" data-kid=\"1-1-2-3-1-2-1-1\" data-name=\"all count\">\n                                04\n                            </span>\n                        </button>\n                        <button class=\"filter-chip focus-ring rounded-md border border-transparent px-2.5 py-1.5 text-[10px] text-[var(--muted)] hover:border-[var(--line)]\" data-dynamic=\"true\" data-filter=\"score\" data-kid=\"1-1-2-3-1-2-2\" data-name=\"score filter chip\" data-reason=\"class list and styles updated by filter script\">\n                            Score ≥55\n                        </button>\n                        <button class=\"filter-chip focus-ring rounded-md border border-transparent px-2.5 py-1.5 text-[10px] text-[var(--muted)] hover:border-[var(--line)]\" data-dynamic=\"true\" data-filter=\"risk\" data-kid=\"1-1-2-3-1-2-3\" data-name=\"risk filter chip\" data-reason=\"class list and styles updated by filter script\">\n                            High risk\n                        </button>\n                        <button class=\"filter-chip focus-ring rounded-md border border-transparent px-2.5 py-1.5 text-[10px] text-[var(--muted)] hover:border-[var(--line)]\" data-dynamic=\"true\" data-filter=\"unknown\" data-kid=\"1-1-2-3-1-2-4\" data-name=\"not scored filter chip\" data-reason=\"class list and styles updated by filter script\">\n                            Not scored\n                        </button>\n                    </div>\n                    <div aria-label=\"Sample token results\" data-kid=\"1-1-2-3-1-3\" data-name=\"radar token results list\" id=\"token-list\" role=\"list\">\n                        <button aria-pressed=\"true\" class=\"radar-row selected focus-ring relative flex w-full items-center gap-3 border-b border-[var(--line-soft)] px-4 py-3.5 text-left\" data-alert=\"Opportunity threshold met\" data-alert-meta=\"Score 67 · sample alert\" data-cap=\"$1.82M\" data-dynamic=\"true\" data-filter-risk=\"true\" data-filter-score=\"true\" data-filter-unknown=\"false\" data-kid=\"1-1-2-3-1-3-1\" data-liquidity=\"$184K\" data-mint=\"2zMMhcVQEXDtdE6VsFSZY4xF6rYzGzCzE6w2ttv7Z9w\" data-name=\"token list item 1\" data-op-label=\"Threshold met · sample rule ≥55\" data-opportunity=\"67\" data-price=\"$0.00318\" data-reason=\"hidden state updated by filter script\" data-risk=\"82\" data-risk-label=\"High risk\" data-symbol=\"PENGU\" role=\"listitem\" type=\"button\">\n                            <span class=\"row-rail absolute bottom-2 left-0 top-2 w-[2px] rounded-full\" data-kid=\"1-1-2-3-1-3-1-1\" data-name=\"item 1 selection rail\">\n                            </span>\n                            <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[9px] border border-[#39413b] bg-[#1c241d] text-[11px] font-bold tracking-[.04em] text-[#cfe7b7]\" data-kid=\"1-1-2-3-1-3-1-2\" data-name=\"item 1 icon placeholder\">\n                                P\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-1-3-1-3\" data-name=\"item 1 content\">\n                                <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-1-2-3-1-3-1-3-1\" data-name=\"item 1 header\">\n                                    <span class=\"truncate text-[13px] font-semibold text-[#eef1ef]\" data-kid=\"1-1-2-3-1-3-1-3-1-1\" data-name=\"item 1 token symbol\">\n                                        $PENGU\n                                    </span>\n                                    <span class=\"dr-mono shrink-0 text-[10px] text-[#c3b2f4]\" data-kid=\"1-1-2-3-1-3-1-3-1-2\" data-name=\"item 1 opportunity score\">\n                                        67\n                                        <span class=\"text-[var(--quiet)]\" data-kid=\"1-1-2-3-1-3-1-3-1-2-1\" data-name=\"item 1 score unit\">\n                                            OPP\n                                        </span>\n                                    </span>\n                                </span>\n                                <span class=\"mt-1 flex items-center justify-between gap-2\" data-kid=\"1-1-2-3-1-3-1-3-2\" data-name=\"item 1 sub-header\">\n                                    <span class=\"truncate text-[10px] text-[var(--muted)]\" data-kid=\"1-1-2-3-1-3-1-3-2-1\" data-name=\"item 1 name\">\n                                        Pudgy Penguins\n                                    </span>\n                                    <span class=\"dr-mono shrink-0 text-[10px] text-[#e7b879]\" data-kid=\"1-1-2-3-1-3-1-3-2-2\" data-name=\"item 1 risk score\">\n                                        82\n                                     