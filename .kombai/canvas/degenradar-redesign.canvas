ly discovered\n                        <span class=\"inline-flex h-3 w-3 items-center justify-center text-[12px]\" data-kid=\"1-2-3-2-5-2-1\">\n                            <i class=\"ti ti-chevron-down\" data-kid=\"1-2-3-2-5-2-1-1\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n                <a class=\"mt-4 flex items-center justify-center gap-1.5 rounded-lg border border-[#2C413A] bg-[#111C18] px-3 py-2.5 text-[10px] font-medium text-[#B4DAC5]\" data-kid=\"1-2-3-2-6\" href=\"#\">\n                    Open full token list\n                    <span class=\"inline-flex h-3 w-3 items-center justify-center text-[12px]\" data-kid=\"1-2-3-2-6-1\">\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-2-6-1-1\">\n                        </i>\n                    </span>\n                </a>\n                <div class=\"mt-8 border-t border-[#1E2D2D] pt-5\" data-kid=\"1-2-3-2-7\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-2-7-1\">\n                        <h3 class=\"text-[12px] font-medium text-[#D8E1DB]\" data-kid=\"1-2-3-2-7-1-1\">\n                            Alert definition\n                        </h3>\n                        <span class=\"dr-mono rounded border border-[#2B3531] px-1.5 py-0.5 text-[8px] text-[#97A49D]\" data-kid=\"1-2-3-2-7-1-2\">\n                            Score ≥55\n                        </span>\n                    </div>\n                    <p class=\"mt-2 max-w-[340px] text-[10px] leading-[1.65] text-[#7D8A84]\" data-kid=\"1-2-3-2-7-2\">\n                        Alerts record a configured score threshold crossing. Risk is assessed separately; a signal is not a buy recommendation.\n                    </p>\n                    <div class=\"mt-3 flex items-center gap-2 text-[9px] text-[#82918A]\" data-kid=\"1-2-3-2-7-3\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#79CDA7]\" data-kid=\"1-2-3-2-7-3-1\">\n                        </span>\n                        Updates delivered via WebSocket\n                    </div>\n                </div>\n            </aside>\n        </div>\n        <footer class=\"mt-9 flex flex-col gap-2 border-t border-[#1A292B] pt-4 text-[9px] text-[#63716C] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-4\">\n            <span data-kid=\"1-2-4-1\">\n                DegenRadar · Solana token intelligence\n            </span>\n            <span class=\"dr-mono\" data-kid=\"1-2-4-2\">\n                SAMPLE DATA · Example events and scores for design preview\n            </span>\n        </footer>\n    </main>\n</div>\n",
