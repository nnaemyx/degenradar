      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css');\n.font-brand { font-family: 'Space Grotesk', sans-serif; }\n.font-data { font-family: 'IBM Plex Mono', monospace; }\n</style>\n<div class=\"font-brand min-h-screen w-full bg-[#090c11] text-slate-100 [background-image:radial-gradient(ellipse_at_6%_0%,rgba(0,255,163,0.045),transparent_31%)]\" data-kid=\"1\">\n    <div class=\"mx-auto max-w-[1500px] px-5 pb-10 sm:px-8 lg:px-10\" data-kid=\"1-1\">\n        <header class=\"flex min-h-[78px] items-center justify-between gap-4 border-b border-white/[0.08] py-4\" data-kid=\"1-1-1\">\n            <div class=\"flex min-w-0 items-center gap-3.5\" data-kid=\"1-1-1-1\">\n                <div class=\"relative grid h-10 w-10 shrink-0 place-items-center rounded-[11px] border border-white/10 bg-[#11171d]\" data-kid=\"1-1-1-1-1\">\n                    <span class=\"absolute left-[8px] top-[8px] h-[7px] w-[7px] border-l-2 border-t-2 border-[#00e59b]\" data-kid=\"1-1-1-1-1-1\">\n                    </span>\n                    <span class=\"absolute right-[8px] top-[8px] h-[7px] w-[7px] border-r-2 border-t-2 border-[#00e59b]\" data-kid=\"1-1-1-1-1-2\">\n                    </span>\n                    <span class=\"absolute bottom-[8px] left-[8px] h-[7px] w-[7px] border-b-2 border-l-2 border-[#8f67ff]\" data-kid=\"1-1-1-1-1-3\">\n                    </span>\n                    <span class=\"absolute bottom-[8px] right-[8px] h-[7px] w-[7px] border-b-2 border-r-2 border-[#8f67ff]\" data-kid=\"1-1-1-1-1-4\">\n                    </span>\n                    <span class=\"h-[5px] w-[5px] rounded-full bg-[#00e59b]\" data-kid=\"1-1-1-1-1-5\">\n                    </span>\n                    <span class=\"absolute right-[5px] top-1/2 h-px w-[5px] -translate-y-1/2 bg-[#00e59b]/70\" data-kid=\"1-1-1-1-1-6\">\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"flex items-baseline gap-1.5 leading-none\" data-kid=\"1-1-1-1-2-1\">\n                        <span class=\"text-[19px] font-bold tracking-[-0.055em] text-white\" data-kid=\"1-1-1-1-2-1-1\">\n                            DEGEN\n                        </span>\n                        <span class=\"text-[19px] font-bold tracking-[-0.055em] text-[#00e59b]\" data-kid=\"1-1-1-1-2-1-2\">\n                            RADAR\n                        </span>\n                        <span class=\"ml-1 hidden rounded border border-white/10 px-1.5 py-0.5 font-data text-[9px] font-medium tracking-[0.1em] text-slate-500 sm:inline\" data-kid=\"1-1-1-1-2-1-3\">\n                            SOLANA\n                        </span>\n                    </div>\n                    <div class=\"mt-1 font-data text-[9px] tracking-[0.13em] text-slate-500\" data-kid=\"1-1-1-1-2-2\">\n                        TOKEN INTELLIGENCE\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-4 sm:gap-6\" data-kid=\"1-1-1-2\">\n                <div class=\"flex items-center gap-2 font-data text-[10px] text-slate-300\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"relative flex h-2 w-2\" data-kid=\"1-1-1-2-1-1\">\n                        <span class=\"absolute inline-flex h-full w-full rounded-full bg-emerald-400/30\" data-kid=\"1-1-1-2-1-1-1\">\n                        </span>\n                        <span class=\"relative inline-flex h-2 w-2 rounded-full bg-emerald-400\" data-kid=\"1-1-1-2-1-1-2\">\n                        </span>\n                    </span>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-1-2\">\n                        Updates connected\n                    </span>\n                    <span class=\"sm:hidden\" data-kid=\"1-1-1-2-1-3\">\n                        Connected\n                    </span>\n                </div>\n                <div class=\"hidden h-7 w-px bg-white/10 sm:block\" data-kid=\"1-1-1-2-2\">\n                </div>\n                <div class=\"hidden items-center gap-5 font-data text-[10px] sm:flex\" data-kid=\"1-1-1-2-3\">\n                    <div data-kid=\"1-1-1-2-3-1\">\n                        <span class=\"text-slate-500\" data-kid=\"1-1-1-2-3-1-1\">\n                            MONITORED\n                        </span>\n                        <div class=\"mt-0.5 text-[13px] font-semibold tabular-nums text-white\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3-1-2\" data-name=\"monitored tokens counter\" data-reason=\"number updated by data-stream\">\n                            128\n                        </div>\n                    </div>\n                    <div data-kid=\"1-1-1-2-3-2\">\n                        <span class=\"text-slate-500\" data-kid=\"1-1-1-2-3-2-1\">\n                            SIGNALS\n                        </span>\n                        <div class=\"mt-0.5 text-[13px] font-semibold tabular-nums text-white\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3-2-2\" data-name=\"signals counter\" data-reason=\"number updated by data-stream\">\n                            06\n                        </div>\n                    </div>\n                </div>\n                <span class=\"inline-flex items-center gap-1.5 rounded-md border border-amber-300/20 bg-amber-300/[0.06] px-2 py-1.5 font-data text-[9px] font-medium tracking-[0.04em] text-amber-200/90\" data-kid=\"1-1-1-2-4\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-amber-300\" data-kid=\"1-1-1-2-4-1\">\n                    </span>\n                    SAMPLE DATA\n                </span>\n            </div>\n        </header>\n        <section aria-label=\"Search tokens\" class=\"pt-6\" data-kid=\"1-1-2\">\n            <div class=\"flex flex-col gap-2.5 sm:flex-row sm:items-center\" data-kid=\"1-1-2-1\">\n                <label class=\"flex h-[48px] min-w-0 flex-1 items-center gap-3 rounded-lg border border-white/[0.12] bg-[#0d1117] px-4 focus-within:border-[#00e59b]/50\" data-kid=\"1-1-2-1-1\">\n                    <span class=\"text-[17px] text-slate-500\" data-kid=\"1-1-2-1-1-1\">\n                        <i class=\"ti ti-search\" data-kid=\"1-1-2-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"sr-only\" data-kid=\"1-1-2-1-1-2\">\n                        Search tokens or paste a Solana mint\n                    </span>\n                    <input class=\"min-w-0 flex-1 bg-transparent font-brand text-[13px] text-white outline-none placeholder:text-slate-500\" data-kid=\"1-1-2-1-1-3\" placeholder=\"Search tokens or paste a Solana mint address\"/>\n                    <kbd class=\"hidden rounded border border-white/10 px-1.5 py-1 font-data text-[9px] text-slate-500 md:inline\" data-kid=\"1-1-2-1-1-4\">\n                        /\n                    </kbd>\n                </label>\n                <button class=\"flex h-[48px] shrink-0 items-center justify-center gap-2 rounded-lg bg-[#00e59b] px-4 text-[12px] font-semibold text-[#07120e] hover:bg-[#25f0ae] sm:px-5\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"text-[15px]\" data-kid=\"1-1-2-1-2-1\">\n                        <i class=\"ti ti-scan\" data-kid=\"1-1-2-1-2-1-1\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-2-1-2-2\">\n                        Scan mint\n                    </span>\n                    <span class=\"hidden font-data text-[9px] font-medium text-[#064b34]/75 sm:inline\" data-kid=\"1-1-2-1-2-3\">\n                        PASTE ADDRESS\n                    </span>\n                </button>\n            </div>\n            <div class=\"mt-2 flex items-center gap-2 pl-1 font-data text-[10px] text-slate-500\" data-kid=\"1-1-2-2\">\n                <i class=\"ti ti-info-circle text-[12px]\" data-kid=\"1-1-2-2-1\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\">\n                    Search filters the radar. A Solana mint address can be scanned on demand.\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Radar filters\" class=\"mt-5 flex flex-col gap-3 border-b border-white/[0.08] pb-4 lg:flex-row lg:items-center lg:justify-between\" data-kid=\"1-1-3\">\n            <div class=\"flex flex-wrap items-center gap-1.5\" data-kid=\"1-1-3-1\">\n                <button class=\"rounded-md bg-[#18221f] px-3 py-2 text-[11px] font-semibold text-[#8ff3ce] ring-1 ring-inset ring-[#00e59b]/20\" data-kid=\"1-1-3-1-1\">\n                    All tokens\n                    <span class=\"ml-1 font-data text-[10px] text-[#8ff3ce]/70\" data-kid=\"1-1-3-1-1-1\">\n                        128\n                    </span>\n                </button>\n                <button class=\"rounded-md px-3 py-2 text-[11px] text-slate-400 hover:bg-white/[0.04] hover:text-slate-200\" data-kid=\"1-1-3-1-2\">\n                    Opportunity\n                    <span class=\"ml-1 font-data text-[10px]\" data-kid=\"1-1-3-1-2-1\">\n                        ≥55\n                    </span>\n                </button>\n                <button class=\"rounded-md px-3 py-2 text-[11px] text-slate-400 hover:bg-white/[0.04] hover:text-slate-200\" data-kid=\"1-1-3-1-3\">\n                    Market cap\n                    <span class=\"ml-1 font-data text-[10px]\" data-kid=\"1-1-3-1-3-1\">\n                        $100K+\n                    </span>\n                </button>\n                <button class=\"rounded-md px-3 py-2 text-[11px] text-slate-400 hover:bg-white/[0.04] hover:text-slate-200\" data-kid=\"1-1-3-1-4\">\n                    Lower risk\n                    <span class=\"ml-1 font-data text-[10px]\" data-kid=\"1-1-3-1-4-1\">\n                        ≤30\n                    </span>\n                </button>\n                <button class=\"rounded-md px-3 py-2 text-[11px] text-slate-400 hover:bg-white/[0.04] hover:text-slate-200\" data-kid=\"1-1-3-1-5\">\n                    Micro cap\n                    <span class=\"ml-1 font-data text-[10px]\" data-kid=\"1-1-3-1-5-1\">\n                        <$100K\n                    </span>\n                </button>\n            </div>\n            <button class=\"flex w-fit items-center gap-2 rounded-md border border-white/[0.09] bg-[#0d1117] px-3 py-2 font-data text-[10px] text-slate-300\" data-kid=\"1-1-3-2\">\n                <span class=\"text-slate-500\" data-kid=\"1-1-3-2-1\">\n                    SORT\n                </span>\n                <span class=\"text-slate-200\" data-kid=\"1-1-3-2-2\">\n                    Opportunity score\n                </span>\n                <i class=\"ti ti-chevron-down text-[12px] text-slate-500\" data-kid=\"1-1-3-2-3\">\n                </i>\n            </button>\n        </section>\n        <main class=\"mt-5 grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_326px] xl:gap-6\" data-kid=\"1-1-4\">\n            <section aria-label=\"Sortable token radar\" class=\"min-w-0\" data-kid=\"1-1-4-1\">\n                <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"1-1-4-1-1\">\n                    <div data-kid=\"1-1-4-1-1-1\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-4-1-1-1-1\">\n                            <h1 class=\"text-[18px] font-semibold tracking-[-0.035em] text-white\" data-kid=\"1-1-4-1-1-1-1-1\">\n                                Token radar\n                            </h1>\n                            <span class=\"rounded border border-white/[0.08] px-1.5 py-0.5 font-data text-[9px] text-slate-500\" data-kid=\"1-1-4-1-1-1-1-2\">\n                                128 RESULTS\n                            </span>\